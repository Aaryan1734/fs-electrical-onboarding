# =============================================================================
# Link build statements for STATIC_LIBRARY target mbed-nanostack


#############################################
# Link the static library mbed-os/connectivity/nanostack/libmbed-nanostack.a

build mbed-os/connectivity/nanostack/libmbed-nanostack.a: CXX_STATIC_LIBRARY_LINKER__mbed-nanostack_Develop mbed-os/connectivity/nanostack/CMakeFiles/mbed-nanostack.dir/source/Nanostack.cpp.obj || mbed-os/connectivity/nanostack/mbed-mesh-api/libmbed-nanostack-mbed_mesh_api.a
  CONFIG = Develop
  LANGUAGE_COMPILE_FLAGS = -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -Wno-psabi -Wno-packed-bitfield-compat -Werror=return-type -fmessage-length=0 -fno-exceptions -ffunction-sections -fdata-sections -funsigned-char -fomit-frame-pointer -g3 -mthumb -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=softfp -Wno-register
  OBJECT_DIR = mbed-os/connectivity/nanostack/CMakeFiles/mbed-nanostack.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = mbed-os/connectivity/nanostack/libmbed-nanostack.a
  TARGET_PDB = mbed-nanostack.a.dbg
  TARGET_SUPPORT_DIR = mbed-os/connectivity/nanostack/CMakeFiles/mbed-nanostack.dir


#############################################
# Utility command for edit_cache

build mbed-os/connectivity/nanostack/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/aaryan/Desktop/fs-electrical-onboarding/build/vcu/mbed-os/connectivity/nanostack && /opt/homebrew/bin/ccmake -S/Users/aaryan/Desktop/fs-electrical-onboarding/fw/vcu -B/Users/aaryan/Desktop/fs-electrical-onboarding/build/vcu
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build mbed-os/connectivity/nanostack/edit_cache: phony mbed-os/connectivity/nanostack/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build mbed-os/connectivity/nanostack/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/aaryan/Desktop/fs-electrical-onboarding/build/vcu/mbed-os/connectivity/nanostack && /opt/homebrew/bin/cmake --regenerate-during-build -S/Users/aaryan/Desktop/fs-electrical-onboarding/fw/vcu -B/Users/aaryan/Desktop/fs-electrical-onboarding/build/vcu
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build mbed-os/connectivity/nanostack/rebuild_cache: phony mbed-os/connectivity/nanostack/CMakeFiles/rebuild_cache.util

