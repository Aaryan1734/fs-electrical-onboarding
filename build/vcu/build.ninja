#############################################
# Link the static library mbed-os/storage/libmbed-storage.a

build mbed-os/storage/libmbed-storage.a: CXX_STATIC_LIBRARY_LINKER__mbed-storage_Develop mbed-os/storage/CMakeFiles/mbed-storage.dir/platform/source/PlatformStorage.cpp.obj || mbed-os/storage/blockdevice/TARGET_FLASH/libmbed-storage-flashiap.a mbed-os/storage/blockdevice/libmbed-storage-blockdevice.a mbed-os/storage/filesystem/fat/libmbed-storage-fat.a mbed-os/storage/filesystem/libmbed-storage-filesystem.a mbed-os/storage/filesystem/littlefs/libmbed-storage-littlefs.a mbed-os/storage/filesystem/littlefsv2/libmbed-storage-littlefs-v2.a
